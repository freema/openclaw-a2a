# OpenClaw Gateway
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# Model name for chat completions (default: openclaw)
# Gateway versions 2026.3.24+ require "openclaw" or "openclaw/<agentId>"
# OPENCLAW_MODEL=openclaw

# Multi-instance (JSON array, has priority over single instance)
# OPENCLAW_INSTANCES=[{"name":"prod","url":"http://127.0.0.1:18789","token":"...","default":true}]

# Server
PORT=3100
HOST=0.0.0.0
DEBUG=false

# Agent Card
PUBLIC_URL=http://localhost:3100

# Security — require a Bearer token on the /a2a endpoint (discovery stays public).
# When unset, the endpoint is open.
# A2A_AUTH_TOKEN=

# Signed Agent Cards — PEM-encoded Ed25519 private key used to sign the Agent Card
# (verifiable at /.well-known/jwks.json). When unset, an ephemeral key is generated
# on startup (the kid changes on every restart). Generate one with:
#   openssl genpkey -algorithm ed25519
# A2A_CARD_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
